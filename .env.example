# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public by design (they ship to the browser); Row Level Security protects the data.
# NEVER put the service_role / secret key in this app or in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Older projects can use the legacy anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional: your deployed origin, for canonical URLs, Open Graph tags and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://recipe-nest-tan.vercel.app
# Optional: public contact address shown on the privacy and terms pages.
# NEXT_PUBLIC_CONTACT_EMAIL=
